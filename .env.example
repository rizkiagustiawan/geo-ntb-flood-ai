# === Satellite Data APIs ===
# Sentinel Hub (https://apps.sentinel-hub.com/)
SH_CLIENT_ID=your_client_id_here
SH_CLIENT_SECRET=your_client_secret_here
SH_INSTANCE_ID=your_instance_id_here

# Earthdata (https://urs.earthdata.nasa.gov/)
EARTHDATA_USER=your_username
EARTHDATA_PASS=your_password

# === Telegram Alerts ===
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# === Celery / Redis ===
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# === API Security ===
# Comma-separated API keys (leave empty for dev mode - no auth)
API_KEYS=
# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# === Data Retention (days) ===
RETENTION_RAW=7
RETENTION_PREDICTIONS=30
RETENTION_REPORTS=14
